# CampusEase environment variables — copy this file to .env.local and fill it in.
# NEVER commit real keys. All values here are placeholders.

# ── Supabase (Project Settings → API) ────────────────────────────────────────
# Used in the browser (Vite replaces VITE_* at build time)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Used on the server (server functions, API routes). Same values as above.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── AI PDF parsing (server only) ─────────────────────────────────────────────
# An OpenAI-compatible chat-completions endpoint — both key and base URL are required, e.g.:
#   AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini
#   AI_BASE_URL=https://openrouter.ai/api/v1   AI_MODEL=openai/gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Allow the server to read AI settings from the admin panel (app_settings) ──
# Supabase → Project Settings → API → service_role key (secret — server only)
SUPABASE_SERVICE_ROLE_KEY=

# ── Site & analytics ──────────────────────────────────
# Your production URL, e.g. https://campusease.app (makes canonical + og:image absolute)
VITE_SITE_URL=
# GA4 property id, e.g. G-XXXXXXXXXX (Analytics only loads when this is set)
VITE_GA_MEASUREMENT_ID=
# Google Search Console verification meta value
VITE_GOOGLE_SITE_VERIFICATION=

# ── Drizzle migrations (optional — only needed for `drizzle-kit migrate`) ────
# Supabase connection string (Project Settings → Database → Connection pooling)
DB_MIGRATION_URL=

# ── Scheduled/cron requests (optional — only used by integrations/supabase/cron-auth.ts) ──
LOVABLE_CRON_SECRET=
